# Renewable Hydrogen ML Assignment (Week 2)

---

## 1. Imports
```python
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.linear_model import LinearRegression, LogisticRegression
from sklearn.ensemble import RandomForestRegressor, RandomForestClassifier
from sklearn.metrics import accuracy_score, confusion_matrix, precision_score, recall_score, f1_score, roc_auc_score, mean_squared_error, mean_absolute_error, r2_score, classification_report
import joblib
```

## 2. Load Dataset
```python
# Option 1: Use your local cleaned CSV
# from Google Drive or local files in Google Colab
df = pd.read_csv('/content/Renewable_Hydrogen_Data_CLEANED.csv')
df.head()
```

## 3. Preprocessing
```python
# Identify target and features
# For demonstration, use Hydrogen_Production_kg/day (regression)
# If you prefer classification, use Feasibility_Score (set as bins)

target = 'Hydrogen_Production_kg/day'
features = [col for col in df.columns if col != target and col != 'City']

X = df[features]
y = df[target]

# Handle missing values (none found, but shown for template)
X = X.fillna(X.mean(numeric_only=True))

# Encode categorical (Latitude_Band)
categorical = ['Latitude_Band']
numerical = [col for col in features if col not in categorical]

preprocessor = ColumnTransformer([
        ('cat', OneHotEncoder(), categorical),
        ('num', StandardScaler(), numerical)
    ])

X_processed = preprocessor.fit_transform(X)
```

## 4. Train-Test Split
```python
X_train, X_test, y_train, y_test = train_test_split(X_processed, y, test_size=0.2, random_state=42)
```

## 5. Model Training & Prediction
### Linear Regression
```python
lr = LinearRegression()
lr.fit(X_train, y_train)
pred_lr = lr.predict(X_test)
```

### Random Forest Regression
```python
rf = RandomForestRegressor(random_state=42)
rf.fit(X_train, y_train)
pred_rf = rf.predict(X_test)
```

## 6. First 10 Results
```python
print('LR Pred vs Actual:', np.array([pred_lr[:10],y_test[:10]]).T)
print('RF Pred vs Actual:', np.array([pred_rf[:10],y_test[:10]]).T)
```

## 7. Metrics
```python
for name,pred in zip(['Linear', 'RF'], [pred_lr, pred_rf]):
    print(f"Model: {name}")
    print("RMSE:", np.sqrt(mean_squared_error(y_test, pred)))
    print("MAE:", mean_absolute_error(y_test, pred))
    print("R2:", r2_score(y_test, pred))
    print("---")
```

## 8. 5-fold CV
```python
scores_rf = cross_val_score(rf, X_processed, y, cv=5)
print("RF CV Mean:", np.mean(scores_rf), "Std:", np.std(scores_rf))
```

## 9. Feature Importances
```python
feat_names = preprocessor.named_transformers_['cat'].get_feature_names_out(categorical).tolist() + numerical
importances = rf.feature_importances_
sns.barplot(x=importances, y=feat_names)
plt.title('Random Forest Feature Importance')
plt.show()
```

## 10. Save Best Model
```python
joblib.dump(rf, 'best_model.joblib')
```

